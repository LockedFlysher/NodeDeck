[Unit]
Description=NodeDeck Unified Account & Built-in EasyTier Mesh Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/nodedeck/nodedeck_mesh_agent.py --state-dir /etc/nodedeck daemon
Restart=always
RestartSec=3
User=root
UMask=0077

[Install]
WantedBy=multi-user.target
